BINDINGS_DIR := "./bindings-rs/src/contract"
BIND_STAMP := "./bindings-rs/src/.bind-stamp"
DEPLOYMENTS_DIR := "./deployments"
GAS_FOUNDRY_VERSION := "1.5.1-v1.5.1"
GAS_DEPENDENCIES_SHA256 := "ef44ca028e8ae45ab0d7a6b183c9db0fded37461db8355456f2b2b876ce57ac3"

default: build

build: build-smart-contracts bind
clean: clean-smart-contracts clean-bindings clean-deployments

build-smart-contracts:
    forge build

test-all: test-disputes test-stf test-stf-fuzzy

test-disputes:
    forge test --no-match-contract ".*FfiTest"

# validate every retained refund-gas witness against the configured allocations
test-gas:
    forge test --match-path "test/gas/TournamentGas.t.sol"

# print the reproducibility header and retained refund-gas measurements
measure-gas:
    "{{ source_directory() / "script/measure-gas.sh" }}" \
      "{{GAS_FOUNDRY_VERSION}}" "{{GAS_DEPENDENCIES_SHA256}}"

# The stateful invariants run in test-disputes. Their deterministic companion
# traces map the same production lifecycle without slow IR instrumentation.
# summarize dispute-game coverage without instrumenting FFI or gas witnesses
coverage:
    #!/usr/bin/env bash
    set -euo pipefail
    step_path=$(cd ../../machine/step && pwd -P)
    # Gas instrumentation changes the production gasleft quantity that the
    # calibration and refund-formula suites are designed to observe.
    excluded_contracts='.*(FfiTest|GasTest|RefundFormulaTest|StateTransitionTest|TournamentLifecycle.*InvariantTest)'
    RUST_LOG="${COVERAGE_RUST_LOG:-error}" forge coverage \
      --ir-minimum \
      --fuzz-runs 256 \
      --fuzz-seed 0x5eed \
      --color never \
      --no-match-contract "$excluded_contracts" \
      --remappings "step/=$step_path/" \
      --no-match-coverage \
        "(^|/)(test|script|dependencies)(/|$)|(^|/)machine/step(/|$)|(^|/)src/state-transition(/|$)" \
      --report summary

# --threads 1: the FFI machine-snapshot helper is not safe for
# concurrent writers sharing one _machine_scratch cache.
test-stf:
    ../../script/machine-image-fingerprint.sh verify yield
    forge test --match-contract ".*FfiTest" --no-match-test ".*Fuzzy" --ffi --threads 1

test-stf-fuzzy:
    ../../script/machine-image-fingerprint.sh verify yield
    forge test --match-contract ".*FfiTest" --match-test ".*Fuzzy" --ffi --threads 1

clean-smart-contracts:
    forge clean

fmt:
    forge fmt

check-fmt:
    forge fmt --check

# print wire-compatibility and deployment-impact fingerprints
compatibility-hashes:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Tournament wire ABI sha256:"
    forge inspect --json Tournament abi | jq -S . | sha256sum
    echo "Tournament semantic storage-layout fingerprint sha256:"
    forge inspect --json Tournament storageLayout \
      | jq -S -f script/storage-layout-semantic.jq | sha256sum
    echo "Tournament metadata-free creation-bytecode fingerprint sha256:"
    forge inspect --no-metadata Tournament bytecode | sha256sum
    echo "Tournament metadata-free runtime-bytecode fingerprint sha256:"
    forge inspect --no-metadata Tournament deployedBytecode | sha256sum
    # Metadata-included bytecode exposes source-only drift that changes CREATE2
    # initcode. Deployment-specific constructor arguments remain separate.
    echo "Tournament metadata-included creation-bytecode fingerprint sha256:"
    forge inspect Tournament bytecode | sha256sum
    echo "Tournament metadata-included runtime-bytecode fingerprint sha256:"
    forge inspect Tournament deployedBytecode | sha256sum
    echo "MultiLevelTournamentFactory wire ABI sha256:"
    forge inspect --json MultiLevelTournamentFactory abi | jq -S . | sha256sum
    echo "MultiLevelTournamentFactory semantic storage-layout fingerprint sha256:"
    forge inspect --json MultiLevelTournamentFactory storageLayout \
      | jq -S -f script/storage-layout-semantic.jq | sha256sum
    echo "MultiLevelTournamentFactory metadata-free creation-bytecode fingerprint sha256:"
    forge inspect --no-metadata MultiLevelTournamentFactory bytecode | sha256sum
    echo "MultiLevelTournamentFactory metadata-free runtime-bytecode fingerprint sha256:"
    forge inspect --no-metadata MultiLevelTournamentFactory deployedBytecode | sha256sum
    echo "MultiLevelTournamentFactory metadata-included creation-bytecode fingerprint sha256:"
    forge inspect MultiLevelTournamentFactory bytecode | sha256sum
    echo "MultiLevelTournamentFactory metadata-included runtime-bytecode fingerprint sha256:"
    forge inspect MultiLevelTournamentFactory deployedBytecode | sha256sum

install-deps:
    forge soldeer install

# diagnose the PRT contract inputs prepared by this module
[script]
doctor:
    "{{ source_directory() / "../../script/contracts-doctor.sh" }}" prt

clean-bindings:
    rm -rf {{BINDINGS_DIR}} {{BIND_STAMP}}

clean-deployments:
    rm -rf {{DEPLOYMENTS_DIR}}

# regenerate Rust bindings only when their inputs changed
bind:
    "{{ source_directory() / "../../script/contract-bindings.sh" }}" generate prt

bind-force: clean-bindings bind
