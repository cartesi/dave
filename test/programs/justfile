set positional-arguments

[private]
clean-program prog:
  #!/usr/bin/env bash
  set -euo pipefail
  program=$1
  case "$program" in
    echo|yield|stress|honeypot) ;;
    *)
      echo "error: unsupported test program: $program" >&2
      exit 2
      ;;
  esac
  rm -rf -- "$program/machine-image" \
    "$program/machine-image.fingerprint" \
    "$program/machine-image.fingerprint.pending"
  rm -f -- "$program"/machine-image.fingerprint.tmp.*

# yield
build-yield: clean-yield
  ./script/build-yield.sh
clean-yield: (clean-program "yield")

# stress: the compute-heavy workload. Each input burns a deterministic
# ~2^29 big cycles by hashing 8 MB of zeros with sha256sum. Several
# level-0 leaf spans per input are therefore fully active - the
# worst-case replay shape the measurement baseline needs.
# build the synthetic instruction-heavy measurement sample
build-stress: clean-stress
  ./script/build-stress.sh
clean-stress: (clean-program "stress")

# echo
build-echo: clean-echo
  ./script/build-echo.sh
clean-echo: (clean-program "echo")

# The honeypot is an opt-in e2e fixture, built from source so that any
# honeypot commit, released or not, can be tested. Its released snapshots
# (v3.0.1) predate Cartesi Machine v0.21 and do not load; once a compatible
# release ships, a sha-pinned snapshot download can replace this build and its
# docker dependency. The image fingerprint records this pin but not a REF
# passed at build time: rebuild by hand after building another commit.
HONEYPOT_REF := "23b31c06f0537cbd33f996f4ecf1ef6bea8363b3" # cartesi/honeypot#37

# Just has no named arguments, so REF=<commit> arrives literally; the
# prefix is stripped so that spelling works like a bare <commit>.
# build the honeypot image from a honeypot commit (requires docker)
build-honeypot REF=HONEYPOT_REF: clean-honeypot-snapshot clean-honeypot-project
  ./script/build-honeypot.sh "${1#REF=}"
clean-honeypot-snapshot: (clean-program "honeypot")
clean-honeypot-project:
    rm -rf honeypot/project

# required lightweight fixtures
build-programs: build-yield build-echo

# acquire both pinned release inputs without discarding valid cached copies
[script]
download-deps:
  ./script/download-deps.sh download
