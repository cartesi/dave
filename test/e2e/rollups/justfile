ANVIL_LOAD_PATH := "../../../cartesi-rollups/contracts/state.json"
DEPLOYMENTS_DIR := "../../../cartesi-rollups/contracts/deployments/31337"

WEB3_PRIVATE_KEY := "0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

set positional-arguments

# Fail fast with a pointer instead of a cryptic jq/lua error when the
# checkout is missing an e2e prerequisite; `just doctor` at the repo
# root diagnoses everything at once.
[private]
preflight PROGRAM SCENARIO:
    #!/usr/bin/env bash
    set -euo pipefail
    fail() {
      echo "preflight: $1" >&2
      echo "preflight: run 'just doctor' at the repo root for a full diagnosis" >&2
      exit 1
    }
    program=$1
    scenario=$2
    [[ "$program" =~ ^[A-Za-z0-9._-]+$ ]] || fail "unsafe program name"
    [[ "$scenario" =~ ^[A-Za-z0-9._-]+$ ]] || fail "unsafe scenario name"
    [ -f "scenarios/$scenario.lua" ] || fail "scenarios/$scenario.lua missing"
    [ -f {{ANVIL_LOAD_PATH}} ] || fail "devnet state.json missing (just rollups-contracts::build-devnet)"
    [ -d {{DEPLOYMENTS_DIR}} ] || fail "devnet deployments missing (just rollups-contracts::build-devnet)"
    for tool in anvil cast lua5.4 cartesi-machine \
        cartesi-machine-stored-hash forge git jq realpath sha256sum \
        sort sqlite3; do
      command -v "$tool" > /dev/null || fail "$tool not on PATH"
    done
    ../../../script/devnet-fingerprint.sh verify >/dev/null 2>&1 \
      || fail "devnet bundle is stale, mixed, or unverified (just rollups-contracts::build-devnet)"
    ../../../script/machine-image-fingerprint.sh verify "$program" \
      >/dev/null 2>&1 \
      || fail "test/programs/$program/machine-image is stale or unverified (rebuild it under test/programs)"
    [ -x ../../../target/debug/cartesi-rollups-prt-node ] \
      || fail "node binary not built (just build-rust-workspace at the repo root)"

# run PRT rollups test. Set TEST_INSTANCE=<free port> for a fully
# isolated parallel run (own anvil port, _state-<id>, dave-<id>.log,
# anvil-<id>.log, _oracle-<id>); Dave:new resets the instance's own
# state dir, so no recipe-level rm - it would race a parallel sibling.
# Set ANVIL_DUMP_PATH to capture a state dump; it is opt-in because
# the flag pair it enables (--dump-state --preserve-historical-states)
# makes anvil retain every historical state in memory, which under
# tens of thousands of fast-forwarded blocks ballooned five parallel
# lanes into swap (the 2026-07-10 battery freezes).
# run one PRT rollups scenario: just test <program> <scenario>
test PROGRAM SCENARIO: (preflight PROGRAM SCENARIO)
  WEB3_PRIVATE_KEY={{WEB3_PRIVATE_KEY}} \
  ANVIL_LOAD_PATH=`realpath {{ANVIL_LOAD_PATH}}` \
  TEMPLATE_MACHINE=`realpath "../../../test/programs/$1/machine-image"` \
  TEMPLATE_MACHINE_HASH=`cartesi-machine-stored-hash "../../../test/programs/$1/machine-image"` \
  DAVE_APP_FACTORY=`jq -r .address {{DEPLOYMENTS_DIR}}/DaveAppFactory.json` \
  INPUT_BOX=`jq -r .address {{DEPLOYMENTS_DIR}}/InputBox.json` \
  ERC20_PORTAL=`jq -r .address {{DEPLOYMENTS_DIR}}/ERC20Portal.json` \
  ERC20_TOKEN=`jq -r .address {{DEPLOYMENTS_DIR}}/TestFungibleToken.json` \
  lua5.4 "scenarios/$2.lua"

# run PRT rollups echo test
test-echo: \
        (test "echo" "simple")

# dispute under SIGKILL/respawn fire; reproduce a run with CHAOS_SEED=<seed>
test-chaos: \
        (test "echo" "chaos")

# run the targeted crash scenarios (SIGKILL at protocol points)
test-kill-all: \
        (test "echo" "kill_catchup") \
        (test "echo" "kill_catchup_batched") \
        (test "echo" "kill_settle") \
        (test "echo" "kill_commitment_build") \
        (test "echo" "kill_mid_match") \
        (test "echo" "kill_join")

# multi-match scenario: four commitments, two concurrent matches, a real timeout elimination
test-multi-sybil: \
        (test "echo" "multi_sybil")

# exact sealed-leaf clock-boundary scenarios
test-sealed-leaf-timeouts: \
        (test "echo" "sealed_leaf_timeout_winner") \
        (test "echo" "sealed_leaf_timeout_both")

# the CI crash slice: cheap (no dispute), plus the multi-record advance batch end to end
test-kill-ci: \
        (test "echo" "kill_catchup_batched")

# the state-transition coverage suite alone (CI runs it on honeypot, whose image it already builds)
test-honeypot-stf: \
        (test "honeypot" "stf_all")

# run PRT rollups honeypot test
test-honeypot-all: \
        (test "honeypot" "deposit_withdrawal") \
        (test "honeypot" "simple_no_input") \
        (test "honeypot" "stf_all") \
        (test "honeypot" "big_input") \
        (test "honeypot" "gc_match") \
        (test "honeypot" "gc_tournament") \
        (test "honeypot" "bad_commitment")

# run the yield suite (stf_revert is yield's unique net: the full revert restore)
test-yield-all: \
        (test "yield" "simple_no_input") \
        (test "yield" "stf_all") \
        (test "yield" "stf_revert") \
        (test "yield" "big_input") \
        (test "yield" "gc_match") \
        (test "yield" "gc_tournament") \
        (test "yield" "bad_commitment")

test-honeypot-ci: \
        (test "honeypot" "simple")

test-yield-ci: \
        (test "yield" "simple")

test-honeypot-case CASE: \
        (test "honeypot" CASE)

test-yield-case CASE: \
        (test "yield" CASE)

# read logs from PRT Rollups node, run in separate terminal after `test-echo`
read-node-logs:
    #!/usr/bin/env bash
    set -euo pipefail
    instance="${TEST_INSTANCE:-}"
    if [ -n "$instance" ] && [[ ! "$instance" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "error: unsafe TEST_INSTANCE: $instance" >&2
      exit 2
    fi
    log="dave${instance:+-$instance}.log"
    cat "$log"
    tail -f "$log"

# Kept for forensics, but at ~5 GB per battery lane the litter can
# quietly fill the disk, which slows every machine store system-wide.
# remove current and legacy state dirs, oracle dirs, and logs left by e2e runs
sweep:
  rm -rf _state* _oracle* _machine_scratch* _battery dave*.log* anvil*.log
  rm -rf ../../../prt/tests/rollups/_state* \
    ../../../prt/tests/rollups/_oracle* \
    ../../../prt/tests/rollups/_machine_scratch* \
    ../../../prt/tests/rollups/_battery \
    ../../../prt/tests/rollups/dave*.log* \
    ../../../prt/tests/rollups/anvil*.log

# download the sepolia honeypot machine snapshot
download-sepolia-honeypot: clean-sepolia-honeypot-snapshot
  mkdir -p sepolia/machine-image
  curl -L \
    https://github.com/cartesi/honeypot/releases/download/v3.0.0/honeypot-snapshot-sepolia.tar.gz | \
    tar -xz -C sepolia/machine-image
clean-sepolia-honeypot-snapshot:
  rm -rf sepolia/machine-image

run-sepolia SCRIPT:
  ( set -a; source sepolia/.env; exec lua "sepolia/$1.lua")
