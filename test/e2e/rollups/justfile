ANVIL_LOAD_PATH := "../../../cartesi-rollups/contracts/state.json"
DEPLOYMENTS_DIR := "../../../cartesi-rollups/contracts/deployments/31337"

set positional-arguments

# diagnose shared integration inputs and retained E2E forensic state
[script]
doctor:
    "{{ source_directory() / "script/doctor.sh" }}"

# Fail fast with a pointer instead of a cryptic jq/lua error when the
# checkout is missing an e2e prerequisite; `just doctor-e2e` at the repo
# root diagnoses everything at once.
[private]
preflight PROGRAM SCENARIO:
    @"{{ source_directory() / "script/preflight.sh" }}" "$1" "$2"

# run PRT rollups test. Set TEST_INSTANCE=<free port> for a fully
# isolated parallel run (own anvil port, _state-<id>, dave-<id>.log,
# anvil-<id>.log, _oracle-<id>); Dave:new resets the instance's own
# state dir, so no recipe-level rm - it would race a parallel sibling.
# run one PRT rollups scenario: just test <program> <scenario>
test PROGRAM SCENARIO: (preflight PROGRAM SCENARIO)
  ANVIL_LOAD_PATH=`realpath {{ANVIL_LOAD_PATH}}` \
  TEMPLATE_MACHINE=`realpath "../../../test/programs/$1/machine-image"` \
  TEMPLATE_MACHINE_HASH=`cartesi-machine-stored-hash "../../../test/programs/$1/machine-image"` \
  DAVE_APP_FACTORY=`cat {{DEPLOYMENTS_DIR}}/DaveAppFactory.txt` \
  INPUT_BOX=`cat {{DEPLOYMENTS_DIR}}/InputBox.txt` \
  lua5.4 "scenarios/$2.lua"

# The black-box smoke the in-crate harness (just test-node-harness) leaves to
# e2e: the node as a process against Lua sybils, under real signals. CI runs
# this list. Serial on one instance: Dave:new resets the state dir, so disk
# holds one scenario's state at a time. Chaos keeps seed 1 unless CHAOS_SEED
# says otherwise.
# run the e2e smoke; node logs land in _smoke/, exit status = failures
smoke:
    #!/usr/bin/env bash
    set -uo pipefail
    # just exits 130 on SIGINT instead of dying of it, so bash would read
    # Ctrl-C as one failed scenario and start the next.
    trap 'exit 130' INT TERM
    scenarios=(
        "echo simple"
        "echo chaos"
        "echo kill_catchup_batched"
        "echo stf_all"
        "yield stf_revert"
    )
    # An unlisted scenario rots in the dark (stf_revert once did).
    for f in scenarios/*.lua; do
        name=$(basename "$f" .lua)
        printf '%s\n' "${scenarios[@]}" | grep -qx ".* $name" \
            || echo "[smoke] WARNING: scenarios/$name.lua is not on the smoke list"
    done
    rm -rf _smoke && mkdir _smoke
    log="dave${TEST_INSTANCE:+-$TEST_INSTANCE}.log"
    failures=0
    for entry in "${scenarios[@]}"; do
        read -r program scenario <<< "$entry"
        start=$SECONDS
        # A scenario that dies before the node starts must not inherit the
        # previous scenario's log.
        rm -f "$log"
        CHAOS_SEED=${CHAOS_SEED:-1} just test "$program" "$scenario"
        rc=$?
        cp "$log" "_smoke/$program-$scenario.log" 2>/dev/null
        [ "$rc" -eq 0 ] || failures=$((failures + 1))
        echo "$program $scenario rc=$rc $((SECONDS - start))s" >> _smoke/results.txt
    done
    echo "[smoke] $failures of ${#scenarios[@]} failed"
    cat _smoke/results.txt
    exit "$failures"

# follow the node log of a running or finished scenario
read-node-logs:
    #!/usr/bin/env bash
    set -euo pipefail
    instance="${TEST_INSTANCE:-}"
    if [ -n "$instance" ] && [[ ! "$instance" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "error: unsafe TEST_INSTANCE: $instance" >&2
      exit 2
    fi
    log="dave${instance:+-$instance}.log"
    tail -n +1 -f "$log"

# Kept for forensics, but at ~5 GB per retained scenario the litter can
# quietly fill the disk, which slows every machine store system-wide.
# remove state dirs, oracle dirs, and logs left by e2e runs
sweep:
  rm -rf _state* _oracle* _machine_scratch* _smoke dave*.log* anvil*.log
