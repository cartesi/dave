# Variables
BINDINGS_DIR := "./bindings-rs/src/contract"
BIND_STAMP := "./bindings-rs/src/.bind-stamp"
DEPLOYMENTS_DIR := "./deployments"
DEVNET_STATE := "state.json"
DEVNET_FINGERPRINT := "state.fingerprint"
DEVNET_FINGERPRINT_PENDING := "state.fingerprint.pending"

default: build

build: build-smart-contracts bind

# remove compiler output, generated bindings, deployment records and the devnet
clean:
    forge clean
    rm -rf {{BINDINGS_DIR}} {{BIND_STAMP}} {{DEPLOYMENTS_DIR}} {{DEVNET_STATE}} \
      {{DEVNET_FINGERPRINT}} {{DEVNET_FINGERPRINT_PENDING}}

fmt:
    forge fmt

check-fmt:
    forge fmt --check

# install the locked dependencies and prune versions the lock no longer names
install-deps:
    forge soldeer install
    ../../script/soldeer-prune.sh

# compile smart contracts
build-smart-contracts:
    forge build

test:
    forge test --no-match-contract ".*FfiTest"

# validate the retained full-stack PRT leaf-proof gas witnesses
test-prt-leaf-gas:
    ../../script/machine-image-fingerprint.sh verify yield
    ./script/test-prt-leaf-gas.sh

# generate LCOV coverage report
coverage:
    forge coverage --no-match-contract ".*FfiTest" \
      --report lcov --lcov-version 2
    genhtml -o coverage lcov.info --rc derive_function_end_line=0

# regenerate Rust bindings only when their inputs changed
bind:
    "{{ source_directory() / "../../script/contract-bindings.sh" }}" generate rollups

bind-force: && bind
    rm -rf {{BINDINGS_DIR}} {{BIND_STAMP}}

# DEVNET_GEOMETRY=canonical deploys the production contracts and geometry
# instead (the release asset); bundle consumers verify against the same
# variable.
# build the devnet bundle on the three-level test table CI and tests run
build-devnet:
    ./script/build-devnet.sh
